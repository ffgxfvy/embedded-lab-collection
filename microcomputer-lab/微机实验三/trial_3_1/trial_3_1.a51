ORG 00H
START: MOV DPTR, #TABLE
S1: MOV A, #00H
MOVC A,@A+DPTR
CJNE A, #01H, S2
LJMP START
S2: MOV PO, A
LCALL DELAY
INC DPTR
LJMP S1

DELAY: MOV R5, #20
D2: MOV R6, #20
D1: MOV R7, #249
DJNZ R7, $
DJNZ R6, D1
DJNZ R5, D2
RET

TABLE: DB 0COH, 0F9H, 0A4H, 0BOH, 99H
DB 92H, 82H, 0F8H, 80H, 90H
DB 01H
END